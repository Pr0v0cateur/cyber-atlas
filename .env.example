# =============================================================================
# CYBER ATLAS - DEVELOPMENT ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env and replace the placeholder values before running.

# API Keys (optional)
THREATFOX_KEY=
OTX_KEY=
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=

# Security Configuration
JWT_SECRET_KEY=change-me-jwt-secret-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
SESSION_SECRET_KEY=change-me-session-secret-minimum-32-characters
SESSION_TTL_SECONDS=86400

# Database Configuration
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=cyber_atlas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=
DATABASE_URL_ASYNC=

# Redis Configuration
REDIS_PASSWORD=change-me-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=

# OpenSearch Configuration
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change-me-opensearch-password
OPENSEARCH_URL=
OPENSEARCH_VERIFY_CERTS=false

# Application Configuration
APP_NAME=Cyber Atlas
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
TRUSTED_HOSTS=*
HTTPS_ONLY=false
BREACH_SERVICE_URL=

# Default Admin Account
DEFAULT_ADMIN_EMAIL=admin@cyberatlas.local
DEFAULT_ADMIN_PASSWORD=change-me-admin-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/cyber_atlas.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# GeoIP Configuration
GEOIP_DATABASE_PATH=./data/GeoLite2-City.mmdb

# IP enrichment
IPAPI_BASE_URL=http://ip-api.com/json
IPAPI_TIMEOUT_SECONDS=5

# Feed Collection Tuning
FEED_TIMEOUT_SECONDS=60
URLHAUS_FEED=recent
THREATFOX_DAYS=30
OTX_LOOKBACK_DAYS=30
OTX_START_DATE=
OTX_PULSE_LIMIT=100
OTX_MAX_PAGES=0
MALWAREBAZAAR_LIMIT=1000
ABUSEIPDB_LIMIT=10000
